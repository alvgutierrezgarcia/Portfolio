---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Technologies from '../components/Technologies.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';

// Idioma por defecto: inglés. La versión en español vive en /es/.
const lang = 'en' as const;
---

<Layout lang={lang}>
  {/*
    Página principal (one-page). Cada sección es un componente con su propio
    anclaje (#about, #experience, #tech, #projects, #contact), enlazado desde
    la barra de navegación con scroll suave. Los slugs de los anclajes se
    traducen por idioma (ver src/i18n/ui.ts).
  */}

  <Hero lang={lang} />

  <About lang={lang} />

  <Experience lang={lang} />

  <Technologies lang={lang} />

  <Projects lang={lang} />

  <Contact lang={lang} />
</Layout>
