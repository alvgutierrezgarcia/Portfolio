---
import { Image } from 'astro:assets';
// Para cambiar de foto, sustituye este import (p. ej. por '../assets/alvaro-gris.jpg').
import alvaroPhoto from '../assets/alvaro.jpg';
import type { Lang } from '../i18n/ui';
import { sectionId, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const photoAlt = t.about.photoAlt;
---

<section id={sectionId(lang, 'about')} class="about">
  <div class="container">
    <header class="section-head reveal">
      <span class="section-head__num">01</span>
      <h2 class="section-head__title">{t.about.title}</h2>
    </header>

    <div class="about__inner">
      <div class="about__text">
        {
          /* El HTML de cada párrafo es contenido propio del diccionario i18n
             (build-time, sin entrada de usuario): solo resalta términos con
             <strong class="about__kw">. */
          t.about.paragraphs.map((html, i) => (
            <p
              class="about__p reveal"
              style={`--reveal-delay: ${60 + i * 80}ms`}
              set:html={html}
            />
          ))
        }
      </div>

      <div class="about__media reveal" style="--reveal-delay: 120ms">
        <figure class="about__photo">
          <Image
            class="about__img"
            src={alvaroPhoto}
            alt={photoAlt}
            widths={[300, 360, 540, 720]}
            sizes="(max-width: 900px) 300px, 360px"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--space-9);
    scroll-margin-top: var(--nav-height);
  }

  .about__inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-8);
    align-items: center;
  }

  /* --- Texto --- */
  .about__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .about__p {
    font-size: var(--fs-lg);
    color: var(--text-muted);
    line-height: var(--lh-normal);
    max-width: 60ch;
  }
  /* Términos clave: más brillantes que el texto de alrededor, sin saturar */
  .about__kw {
    color: var(--text);
    font-weight: var(--fw-semibold);
  }

  /* --- Foto --- */
  .about__media {
    display: flex;
    justify-content: center;
  }
  .about__photo {
    position: relative;
    width: 100%;
    max-width: 360px;
    aspect-ratio: 4 / 5;
    margin: 0;
  }
  /* Marco de acento desplazado detrás de la foto */
  .about__photo::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: translate(14px, 14px);
    border: 1.5px solid var(--accent);
    border-radius: var(--radius-lg);
    opacity: 0.55;
    z-index: 0;
    transition: transform var(--transition-slow);
  }
  .about__photo:hover::before {
    transform: translate(10px, 10px);
  }

  .about__img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    object-fit: cover;
  }

  /* ======================= RESPONSIVE ======================= */
  @media (max-width: 900px) {
    .about__inner {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
    .about__media {
      order: -1; /* la foto arriba en móvil */
    }
    .about__photo {
      max-width: 300px;
    }
  }
</style>
