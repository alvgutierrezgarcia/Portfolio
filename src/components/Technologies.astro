  { title: 'Backend', items: [dotnet, csharp, sqlserver] },
  { title: 'Frontend', items: [angular, typescript] },
  { title: 'Datos e IA', items: [python, machineLearning, computerVision, llms] },
  { title: 'Herramientas', items: [git, github, vscode] },
];

// Índice global para escalonar la animación de aparición a través de toda la rejilla.
let i = 0;
---

<section id="tecnologias" class="tech">
  <div class="container">
    <header class="section-head reveal">
      <span class="section-head__num">03</span>
      <h2 class="section-head__title">Tecnologías</h2>
    </header>

    <div class="tech__categories">
      {
        categories.map((cat) => (
          <div class="tech__category">
            <h3
              class="tech__cat-title reveal"
              style={`--reveal-delay:${Math.min(i++, 10) * 40}ms`}
            >
              {cat.title}
            </h3>
            <ul class="tech__grid">
              {cat.items.map((icon) => (
                <li
                  class="tech__card reveal"
                  style={`--reveal-delay:${Math.min(i++, 14) * 40}ms`}
                >
                  <span class="tech__icon-box">
                    <svg
                      class:list={['tech__icon', icon.kind === 'stroke' && 'tech__icon--stroke']}
                      viewBox={icon.viewBox}
                      aria-hidden="true"
                      set:html={icon.inner}
                    />
                  </span>
                  <span class="tech__name">{icon.name}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tech {
    padding-block: var(--space-9);
    scroll-margin-top: var(--nav-height);
  }

  .tech__categories {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .tech__cat-title {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-4);
  }

  .tech__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--space-4);
  }

  .tech__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-align: center;
    transition:
      transform var(--transition),
      border-color var(--transition),
      background-color var(--transition),
      box-shadow var(--transition);
  }

  .tech__card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    background: var(--surface-hover);
    box-shadow: var(--shadow-md);
  }

  .tech__icon-box {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition:
      color var(--transition),
      border-color var(--transition),
      background-color var(--transition),
      transform var(--transition);
  }

  .tech__card:hover .tech__icon-box {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: scale(1.06);
  }

  .tech__icon {
    width: 1.6rem;
    height: 1.6rem;
    fill: currentColor;
  }
  .tech__icon--stroke {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tech__name {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--text-muted);
    transition: color var(--transition);
  }
  .tech__card:hover .tech__name {
    color: var(--text);
  }

  @media (max-width: 480px) {
    .tech__grid {
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
      gap: var(--space-3);
    }
  }
</style>
