---
import { EMAIL, LINKEDIN_URL, GITHUB_URL } from '../data/contact';
import type { Lang } from '../i18n/ui';
import { sectionId, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Los mensajes del validador y del envío se consumen desde el script de
// cliente vía data-* (evita duplicar los textos en JS).
const messages = {
  errName: t.contact.errors.name,
  errEmail: t.contact.errors.email,
  errEmailInvalid: t.contact.errors.emailInvalid,
  errMessage: t.contact.errors.message,
  errMessageShort: t.contact.errors.messageShort,
  statusSent: t.contact.status.sent,
  statusError: t.contact.status.error,
  statusGenericFail: t.contact.status.genericFail,
  // El asunto lleva el nombre; usamos un marcador que el script sustituye.
  subject: t.contact.emailSubject('{name}'),
};
---

<section id={sectionId(lang, 'contact')} class="contact">
  <div class="container">
    <header class="section-head reveal">
      <span class="section-head__num">05</span>
      <h2 class="section-head__title">{t.contact.title}</h2>
    </header>

    <div class="contact__inner">
      <form
        class="contact__form reveal"
        data-contact-form
        novalidate
        data-err-name={messages.errName}
        data-err-email={messages.errEmail}
        data-err-email-invalid={messages.errEmailInvalid}
        data-err-message={messages.errMessage}
        data-err-message-short={messages.errMessageShort}
        data-status-sent={messages.statusSent}
        data-status-error={messages.statusError}
        data-status-generic-fail={messages.statusGenericFail}
        data-subject={messages.subject}
      >
        <div class="field">
          <label for="name">{t.contact.name}</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
          <p class="field__error" data-error-for="name"></p>
        </div>

        <div class="field">
          <label for="email">{t.contact.email}</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
          <p class="field__error" data-error-for="email"></p>
        </div>

        <div class="field">
          <label for="message">{t.contact.message}</label>
          <textarea id="message" name="message" rows="5" required></textarea>
          <p class="field__error" data-error-for="message"></p>
        </div>

        <!-- Honeypot anti-spam de Web3Forms: debe quedar siempre vacío/sin marcar. -->
        <input
          type="checkbox"
          name="botcheck"
          class="contact__honeypot"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />

        <button type="submit" class="btn btn--primary contact__submit">
          <span class="contact__spinner" aria-hidden="true"></span>
          <span class="contact__submit-label">{t.contact.submit}</span>
        </button>

        <p class="contact__status" data-status role="status" aria-live="polite"></p>
      </form>

      <aside class="contact__direct reveal" style="--reveal-delay:120ms">
        <p class="contact__direct-lead">{t.contact.directLead}</p>
        <ul class="contact__links">
          <li>
            <a class="contact__link" href={`mailto:${EMAIL}`}>
              <span class="contact__link-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="M3 7 L12 13 L21 7" />
                </svg>
              </span>
              <span class="contact__link-text">
                <span class="contact__link-label">Email</span>
                <span class="contact__link-value">{EMAIL}</span>
              </span>
            </a>
          </li>
          <li>
            <a class="contact__link" href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">
              <span class="contact__link-icon">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
                </svg>
              </span>
              <span class="contact__link-text">
                <span class="contact__link-label">LinkedIn</span>
                <span class="contact__link-value">{t.contact.viewProfile}</span>
              </span>
            </a>
          </li>
          <li>
            <a class="contact__link" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
              <span class="contact__link-icon">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.82-.26.82-.58v-2.03c-3.34.73-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.1-.75.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.84 2.8 1.3 3.49.99.1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.4 1.24-3.24-.13-.3-.54-1.53.11-3.18 0 0 1.01-.32 3.3 1.24a11.5 11.5 0 0 1 6 0c2.29-1.56 3.3-1.24 3.3-1.24.65 1.65.24 2.88.12 3.18.77.84 1.23 1.92 1.23 3.24 0 4.63-2.8 5.65-5.48 5.95.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5z" />
                </svg>
              </span>
              <span class="contact__link-text">
                <span class="contact__link-label">GitHub</span>
                <span class="contact__link-value">{t.contact.viewProfile}</span>
              </span>
            </a>
          </li>
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--space-9);
    scroll-margin-top: var(--nav-height);
  }

  .contact__inner {
    display: grid;
    grid-template-columns: 1.3fr 0.85fr;
    gap: var(--space-8);
    align-items: start;
    max-width: var(--container);
  }

  /* --- Formulario --- */
  .contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .field label {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--text-muted);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text);
    font-family: var(--font-body);
    font-size: var(--fs-base);
    resize: vertical;
    transition:
      border-color var(--transition),
      background-color var(--transition);
  }
  .field input:hover,
  .field textarea:hover {
    border-color: var(--border-strong);
  }
  .field input:focus,
  .field textarea:focus {
    border-color: var(--accent);
    background: var(--surface-hover);
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--text-faint);
  }

  .field--invalid input,
  .field--invalid textarea {
    border-color: var(--danger);
  }

  .field__error {
    font-size: var(--fs-xs);
    color: var(--danger);
    min-height: 1em;
  }
  .field__error:empty {
    display: none;
  }

  /* Honeypot: invisible para personas, presente para bots */
  .contact__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  .contact__submit {
    align-self: flex-start;
    margin-top: var(--space-2);
    min-width: 10rem;
  }
  .contact__submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .contact__spinner {
    display: none;
    width: 1em;
    height: 1em;
    border: 2px solid color-mix(in srgb, var(--accent-contrast) 35%, transparent);
    border-top-color: var(--accent-contrast);
    border-radius: 50%;
  }
  .contact__form[data-state='sending'] .contact__spinner {
    display: inline-block;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .contact__status {
    font-size: var(--fs-sm);
    min-height: 1.2em;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    display: none;
  }
  .contact__form[data-state='sent'] .contact__status {
    display: block;
    color: var(--success);
    background: var(--success-soft);
    border: 1px solid color-mix(in srgb, var(--success) 40%, transparent);
  }
  .contact__form[data-state='error'] .contact__status {
    display: block;
    color: var(--danger);
    background: var(--danger-soft);
    border: 1px solid color-mix(in srgb, var(--danger) 40%, transparent);
  }

  /* --- Enlaces directos --- */
  .contact__direct-lead {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .contact__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--transition),
      transform var(--transition),
      background-color var(--transition);
  }
  .contact__link:hover {
    border-color: var(--accent);
    background: var(--surface-hover);
    transform: translateY(-2px);
    color: var(--text);
  }

  .contact__link-icon {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--surface-2);
    color: var(--text-muted);
    transition: color var(--transition);
  }
  .contact__link-icon svg {
    width: 1.2rem;
    height: 1.2rem;
  }
  .contact__link:hover .contact__link-icon {
    color: var(--accent);
  }

  .contact__link-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .contact__link-label {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text);
  }
  .contact__link-value {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .contact__inner {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // ============================================================
  // Contacto → Web3Forms (sin backend).
  // 1. Crea una cuenta gratuita en https://web3forms.com
  // 2. Copia tu "Access Key" y pégala aquí abajo.
  // ============================================================
  const WEB3FORMS_ACCESS_KEY = 'e6e03917-a6c2-4187-a0a3-f5786cf36ef0';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const status = form.querySelector<HTMLParagraphElement>('[data-status]')!;
    // Textos traducidos inyectados por el servidor (ver Contact.astro).
    const msg = {
      name: form.dataset.errName ?? '',
      email: form.dataset.errEmail ?? '',
      emailInvalid: form.dataset.errEmailInvalid ?? '',
      message: form.dataset.errMessage ?? '',
      messageShort: form.dataset.errMessageShort ?? '',
      sent: form.dataset.statusSent ?? '',
      error: form.dataset.statusError ?? '',
      genericFail: form.dataset.statusGenericFail ?? '',
      subject: form.dataset.subject ?? '{name}',
    };
    const fields = {
      name: form.elements.namedItem('name') as HTMLInputElement,
      email: form.elements.namedItem('email') as HTMLInputElement,
      message: form.elements.namedItem('message') as HTMLTextAreaElement,
    };

    const setState = (state: 'idle' | 'sending' | 'sent' | 'error') => {
      form.dataset.state = state;
      const isSending = state === 'sending';
      fields.name.disabled = isSending;
      fields.email.disabled = isSending;
      fields.message.disabled = isSending;
      form.querySelector('button[type="submit"]')?.toggleAttribute('disabled', isSending);
    };

    const clearErrors = () => {
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
        el.textContent = '';
      });
      form.querySelectorAll('.field').forEach((el) => el.classList.remove('field--invalid'));
    };

    const showError = (field: keyof typeof fields, msg: string) => {
      const el = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
      if (el) el.textContent = msg;
      fields[field].closest('.field')?.classList.add('field--invalid');
    };

    const validate = () => {
      clearErrors();
      let valid = true;
      const name = fields.name.value.trim();
      const email = fields.email.value.trim();
      const message = fields.message.value.trim();

      if (!name) {
        showError('name', msg.name);
        valid = false;
      }
      if (!email) {
        showError('email', msg.email);
        valid = false;
      } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('email', msg.emailInvalid);
        valid = false;
      }
      if (!message) {
        showError('message', msg.message);
        valid = false;
      } else if (message.length < 10) {
        showError('message', msg.messageShort);
        valid = false;
      }
      return valid;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) {
        setState('idle');
        return;
      }

      setState('sending');
      status.textContent = '';

      const honeypot = form.elements.namedItem('botcheck') as HTMLInputElement;
      const name = fields.name.value.trim();

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: WEB3FORMS_ACCESS_KEY,
            subject: msg.subject.replace('{name}', name),
            from_name: name,
            name,
            email: fields.email.value.trim(),
            message: fields.message.value.trim(),
            botcheck: honeypot?.checked ?? false,
          }),
        });

        const data = await res.json();

        if (data.success) {
          setState('sent');
          status.textContent = msg.sent;
          form.reset();
        } else {
          throw new Error(data.message || msg.genericFail);
        }
      } catch (err) {
        setState('error');
        status.textContent = msg.error;
      } finally {
        const isSending = false;
        fields.name.disabled = isSending;
        fields.email.disabled = isSending;
        fields.message.disabled = isSending;
        form.querySelector('button[type="submit"]')?.removeAttribute('disabled');
      }
    });
  }
</script>
